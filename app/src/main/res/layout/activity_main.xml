<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="20dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="TGM Raid Watcher" android:textSize="28sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="8dp"
  android:text="Bruiser • Hitmen/Sniper • Bikers • mixed raids"/>
 <Button android:id="@+id/startButton" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="24dp"
  android:text="Start Raid Monitor"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="16dp"
  android:text="Status: stopped"/>
</LinearLayout>
